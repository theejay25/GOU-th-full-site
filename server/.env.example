# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5500/GOUTH  # base URL of the frontend site; includes subfolder path if served under one (e.g. /GOUTH)

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/blog_app

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
MAX_UPLOAD_MB=5

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
# 587 -> SMTP_SECURE=false (STARTTLS). 465 -> SMTP_SECURE=true (implicit TLS). Don't mix these up.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Blog App <no-reply@blogapp.com>"
# Only set to "false" if you know why (e.g. self-signed cert on an internal relay).
# Leaving this true (default) protects against man-in-the-middle attacks.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Token expiry (ms) for email verification / password reset links
EMAIL_VERIFICATION_EXPIRES_MS=86400000
PASSWORD_RESET_EXPIRES_MS=3600000

# Where "Contact us" form submissions are delivered
HOSPITAL_CONTACT_EMAIL=info@yourhospital.com
